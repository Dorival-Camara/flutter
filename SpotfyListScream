import 'package:flutter/material.dart';

class PlayListSreen extends StatefulWidget {
  const PlayListSreen({super.key});

  @override
  State<PlayListSreen> createState() => _PlayListSreenState();
}

class _PlayListSreenState extends State<PlayListSreen> {
  bool isFollowing = false;
  bool isPlaying = false;

  final List<Map<String, String>> musicas = [
    {
      'titulo': 'Blinding Lights',
      'artista': 'The Weeknd',
      'duracao': '3:22',
    },
    {
      'titulo': 'Shape of You',
      'artista': 'Ed Sheeran',
      'duracao': '3:53',
    },
    {
      'titulo': 'Dance Monkey',
      'artista': 'Tones and I',
      'duracao': '3:29',
    },
    {
      'titulo': 'Rockstar',
      'artista': 'Post Malone ft. 21 Savage',
      'duracao': '3:39',
    },
    {
      'titulo': 'Someone You Loved',
      'artista': 'Lewis Capaldi',
      'duracao': '3:02',
    },
    {
      'titulo': 'Bad Guy',
      'artista': 'Billie Eilish',
      'duracao': '3:14',
    },
    {
      'titulo': 'Senorita',
      'artista': 'Shawn Mendes & Camila Cabello',
      'duracao': '3:10',
    },
    {
      'titulo': 'Circles',
      'artista': 'Post Malone',
      'duracao': '3:35',
    },
    {
      'titulo': 'Watermelon Sugar',
      'artista': 'Harry Styles',
      'duracao': '2:54',
    },
    {
      'titulo': 'Levitating',
      'artista': 'Dua Lipa',
      'duracao': '3:23',
    },
  ];

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      backgroundColor: const Color(0xFF121212),
      body: SafeArea(
        child: SingleChildScrollView(
          child: Column(
            crossAxisAlignment: CrossAxisAlignment.start,
            children: [
              // Banner da Playlist
              _buildBanner(context),

              // Informações da Playlist
              _buildPlaylistInfo(),

              // Botões de Ação
              _buildActionButtons(),

              // Lista de Músicas
              _buildListaMusicas(),

              const SizedBox(height: 20),
            ],
          ),
        ),
      ),
      bottomNavigationBar: _buildBottomNavigationBar(),
    );
  }

  Widget _buildBanner(BuildContext context) {
    return Stack(
      children: [
        // Imagem do Banner
        SizedBox(
          width: double.infinity,
          height: 300,
          child: Image.network(
            'https://upload.wikimedia.org/wikipedia/commons/thumb/2/26/Spotify_logo_with_text.svg/960px-Spotify_logo_with_text.svg.png',
            fit: BoxFit.cover,
            errorBuilder: (context, error, stackTrace) {
              return Container(
                color: const Color(0xFF1DB954),
                child: const Icon(
                  Icons.music_note,
                  color: Colors.white,
                  size: 80,
                ),
              );
            },
          ),
        ),
        // Gradiente sobre o Banner
        Container(
          height: 300,
          decoration: const BoxDecoration(
            gradient: LinearGradient(
              colors: [Colors.transparent, Color(0xFF121212)],
              begin: Alignment.topCenter,
              end: Alignment.bottomCenter,
            ),
          ),
        ),
        // Botão Voltar
        Positioned(
          top: 10,
          left: 10,
          child: Container(
            decoration: BoxDecoration(
              color: Colors.black.withOpacity(0.5),
              shape: BoxShape.circle,
            ),
            child: IconButton(
              icon: const Icon(Icons.arrow_back, color: Colors.white),
              onPressed: () => Navigator.pop(context),
            ),
          ),
        ),
        // Botão de opções
        Positioned(
          top: 10,
          right: 10,
          child: Container(
            decoration: BoxDecoration(
              color: Colors.black.withOpacity(0.5),
              shape: BoxShape.circle,
            ),
            child: IconButton(
              icon: const Icon(Icons.more_vert, color: Colors.white),
              onPressed: () {},
            ),
          ),
        ),
      ],
    );
  }

  Widget _buildPlaylistInfo() {
    return Padding(
      padding: const EdgeInsets.symmetric(horizontal: 16.0),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          // Nome da Playlist
          const Text(
            'Pop Internacional',
            style: TextStyle(
              color: Colors.white,
              fontSize: 26,
              fontWeight: FontWeight.bold,
            ),
          ),
          const SizedBox(height: 8),
          // Descrição
          const Text(
            'Os maiores hits do pop internacional em um só lugar. Atualize seu mood com as melhores músicas!',
            style: TextStyle(
              color: Colors.grey,
              fontSize: 13,
            ),
          ),
          const SizedBox(height: 12),
          // Informações da playlist
          Row(
            children: [
              CircleAvatar(
                radius: 12,
                backgroundColor: const Color(0xFF1DB954),
                child: const Icon(
                  Icons.person,
                  color: Colors.white,
                  size: 16,
                ),
              ),
              const SizedBox(width: 8),
              const Text(
                'Spotify',
                style: TextStyle(
                  color: Colors.white,
                  fontWeight: FontWeight.bold,
                  fontSize: 13,
                ),
              ),
              const SizedBox(width: 4),
              const Text(
                '• 10 músicas,',
                style: TextStyle(
                  color: Colors.grey,
                  fontSize: 13,
                ),
              ),
              const SizedBox(width: 4),
              const Text(
                'cerca de 33 min',
                style: TextStyle(
                  color: Colors.grey,
                  fontSize: 13,
                ),
              ),
            ],
          ),
        ],
      ),
    );
  }

  Widget _buildActionButtons() {
    return Padding(
      padding: const EdgeInsets.symmetric(horizontal: 16.0, vertical: 12.0),
      child: Row(
        children: [
          // Botão Curtir
          IconButton(
            onPressed: () {
              setState(() {
                isFollowing = !isFollowing;
              });
            },
            icon: Icon(
              isFollowing ? Icons.favorite : Icons.favorite_border,
              color: isFollowing ? const Color(0xFF1DB954) : Colors.grey,
              size: 28,
            ),
          ),
          // Botão Download
          IconButton(
            onPressed: () {},
            icon: const Icon(
              Icons.download_outlined,
              color: Colors.grey,
              size: 28,
            ),
          ),
          // Botão Mais Opções
          IconButton(
            onPressed: () {},
            icon: const Icon(
              Icons.more_horiz,
              color: Colors.grey,
              size: 28,
            ),
          ),
          const Spacer(),
          // Botão Shuffle
          IconButton(
            onPressed: () {},
            icon: const Icon(
              Icons.shuffle,
              color: Color(0xFF1DB954),
              size: 28,
            ),
          ),
          // Botão Play Principal
          GestureDetector(
            onTap: () {
              setState(() {
                isPlaying = !isPlaying;
              });
            },
            child: Container(
              width: 56,
              height: 56,
              decoration: const BoxDecoration(
                color: Color(0xFF1DB954),
                shape: BoxShape.circle,
              ),
              child: Icon(
                isPlaying ? Icons.pause : Icons.play_arrow,
                color: Colors.black,
                size: 32,
              ),
            ),
          ),
        ],
      ),
    );
  }

  Widget _buildListaMusicas() {
    return ListView.builder(
      shrinkWrap: true,
      physics: const NeverScrollableScrollPhysics(),
      itemCount: musicas.length,
      itemBuilder: (context, index) {
        final musica = musicas[index];
        return _buildMusicaTile(musica, index);
      },
    );
  }

  Widget _buildMusicaTile(Map<String, String> musica, int index) {
    return Padding(
      padding: const EdgeInsets.symmetric(horizontal: 16.0, vertical: 4.0),
      child: Row(
        children: [
          // Thumbnail / Número
          Container(
            width: 48,
            height: 48,
            decoration: BoxDecoration(
              color: const Color(0xFF282828),
              borderRadius: BorderRadius.circular(4),
            ),
            child: Center(
              child: Text(
                '${index + 1}',
                style: const TextStyle(
                  color: Colors.grey,
                  fontSize: 14,
                ),
              ),
            ),
          ),
          const SizedBox(width: 12),
          // Título e Artista
          Expanded(
            child: Column(
              crossAxisAlignment: CrossAxisAlignment.start,
              children: [
                Text(
                  musica['titulo']!,
                  style: const TextStyle(
                    color: Colors.white,
                    fontSize: 15,
                    fontWeight: FontWeight.w500,
                  ),
                  maxLines: 1,
                  overflow: TextOverflow.ellipsis,
                ),
                const SizedBox(height: 2),
                Text(
                  musica['artista']!,
                  style: const TextStyle(
                    color: Colors.grey,
                    fontSize: 13,
                  ),
                  maxLines: 1,
                  overflow: TextOverflow.ellipsis,
                ),
              ],
            ),
          ),
          // Duração
          Text(
            musica['duracao']!,
            style: const TextStyle(
              color: Colors.grey,
              fontSize: 13,
            ),
          ),
          const SizedBox(width: 8),
          // Ícone de opções
          IconButton(
            onPressed: () {},
            icon: const Icon(
              Icons.more_vert,
              color: Colors.grey,
              size: 20,
            ),
          ),
        ],
      ),
    );
  }

  Widget _buildBottomNavigationBar() {
    return BottomNavigationBar(
      backgroundColor: const Color(0xFF000000),
      selectedItemColor: Colors.white,
      unselectedItemColor: Colors.grey,
      currentIndex: 1,
      type: BottomNavigationBarType.fixed,
      items: const [
        BottomNavigationBarItem(
          icon: Icon(Icons.home_outlined),
          activeIcon: Icon(Icons.home),
          label: 'Início',
        ),
        BottomNavigationBarItem(
          icon: Icon(Icons.search),
          label: 'Buscar',
        ),
        BottomNavigationBarItem(
          icon: Icon(Icons.library_music_outlined),
          activeIcon: Icon(Icons.library_music),
          label: 'Sua Biblioteca',
        ),
      ],
    );
  }
}
